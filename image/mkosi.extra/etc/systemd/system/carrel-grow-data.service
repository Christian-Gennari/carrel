[Unit]
Description=Grow the Carrel data partition to fill the disk
Documentation=file:///usr/share/doc/carrel
DefaultDependencies=no
After=systemd-udevd.service
Before=data.mount local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/carrel/grow-data

[Install]
WantedBy=local-fs.target
