[Unit]
Description=Carrel installer (only active when booted from a USB stick)
Documentation=file:///usr/share/doc/carrel
After=local-fs.target
Before=graphical.target carrel-session.service
ConditionPathExists=/dev/tty1

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity
ExecStart=/usr/lib/carrel/installer

[Install]
WantedBy=graphical.target
