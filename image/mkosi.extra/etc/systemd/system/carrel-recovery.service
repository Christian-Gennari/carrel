[Unit]
Description=Carrel recovery menu
Documentation=file:///usr/share/doc/carrel
Conflicts=graphical.target
After=local-fs.target data.mount
Before=carrel-recovery.target

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity
ExecStart=/usr/lib/carrel/recovery

[Install]
WantedBy=carrel-recovery.target
