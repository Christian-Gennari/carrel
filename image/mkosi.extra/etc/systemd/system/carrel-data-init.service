[Unit]
Description=Mount Carrel state (/var, /etc overlay) from the data partition
Documentation=file:///usr/share/doc/carrel
DefaultDependencies=no
Requires=data.mount
After=data.mount boot.mount
Before=sysinit.target systemd-journald.service
ConditionPathExists=/dev/disk/by-partlabel/carrel-data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/carrel/data-init

[Install]
WantedBy=sysinit.target
