[Unit]
Description=Mount Stylos state (/var, /etc overlay) from the data partition
Documentation=file:///usr/share/doc/stylos
DefaultDependencies=no
Requires=data.mount
After=data.mount boot.mount
Before=sysinit.target systemd-journald.service
ConditionPathExists=/dev/disk/by-partlabel/stylos-data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/stylos/data-init

[Install]
WantedBy=sysinit.target
