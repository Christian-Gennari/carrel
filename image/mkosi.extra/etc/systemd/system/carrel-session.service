[Unit]
Description=Carrel session (Cage + carrel-shell)
After=systemd-user-sessions.service systemd-logind.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service
# If carrel-shell crashes, restart it immediately and do not let the start
# rate limiter put the device into a dead state.
StartLimitIntervalSec=0

[Service]
Type=simple
User=writer
Group=writer
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
# Cage is the only compositor and its default (without `-s`) keeps VT
# switching disabled. `cage -s` would *allow* VT switching on cage 0.2, which
# breaks rule 1, so it is deliberately not passed here. `-d` suppresses
# client-side decorations so the single client owns the whole screen.
# GPU or software drawing: session-env writes the environment before each
# start, session-check falls back to software after a renderer failure. The
# `+` runs both as root, because /run/carrel belongs to root.
ExecStartPre=+/usr/lib/carrel/session-env
EnvironmentFile=-/run/carrel/session.env
ExecStart=/usr/bin/cage -d -- /usr/bin/carrel-shell
ExecStopPost=+/usr/lib/carrel/session-check
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
