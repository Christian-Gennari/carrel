[Unit]
Description=Stylos recovery menu
Documentation=file:///usr/share/doc/stylos
Conflicts=graphical.target
After=local-fs.target data.mount
Before=stylos-recovery.target

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=infinity
ExecStart=/usr/lib/stylos/recovery

[Install]
WantedBy=stylos-recovery.target
