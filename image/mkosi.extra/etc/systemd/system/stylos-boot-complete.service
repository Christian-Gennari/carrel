[Unit]
Description=Mark the booted Stylos slot good
Documentation=file:///usr/share/doc/stylos
# Runs in the graphical transaction after the session and stylosd started.
# It must not be ordered After=graphical.target: graphical.target waits for
# its wants, which would create an ordering cycle.  The script itself applies
# the same test as systemd-boot-check-no-failures (no failed units).
After=stylos-session.service stylosd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/stylos/boot-complete
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
