[Unit]
Description=Grow the Stylos data partition to fill the disk
Documentation=file:///usr/share/doc/stylos
DefaultDependencies=no
After=systemd-udevd.service
Before=data.mount local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/stylos/grow-data

[Install]
WantedBy=local-fs.target
