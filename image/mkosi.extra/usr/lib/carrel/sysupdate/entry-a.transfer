[Transfer]

[Source]
Type=regular-file
Path=/data/.carrel/update/payload
MatchPattern=carrel-a-@v.conf

[Target]
Type=regular-file
Path=/loader/entries
PathRelativeTo=esp
# +3 is the systemd-boot boot-counting suffix: three attempts before the
# entry is discarded and the previous slot boots.  The entry is a Boot Loader
# Specification Type #1 file; the kernel and initrd are the shared ones in
# /carrel on the ESP.
MatchPattern=carrel-a-@v+3.conf
