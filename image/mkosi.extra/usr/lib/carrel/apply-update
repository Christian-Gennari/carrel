#!/bin/sh
# Apply a staged update with systemd-sysupdate and reboot.
#
# The payload is staged on the data partition (during a sync, or by a service
# technician from a USB stick) as:
#
#   /data/.carrel/update/payload/carrel-root-<slot>-<version>.raw
#   /data/.carrel/update/payload/carrel-verity-<slot>-<version>.raw
#   /data/.carrel/update/payload/carrel-verity-<slot>-sig-<version>.sig
#   /data/.carrel/update/payload/carrel-<slot>-<version>.conf   (boot entry)
#
# Only the inactive slot is touched.  The transfer definitions live in
# /usr/lib/carrel/sysupdate and are selected here, so a boot from slot B
# writes slot A and vice versa.
set -eu

log() {
    echo "CARREL-UPDATE: $*" >&2
    echo "CARREL-UPDATE: $*" >>/dev/ttyS0 2>/dev/null || true
}

slot="$(sed -n 's/.*carrel\.slot=\([ab]\).*/\1/p' /proc/cmdline)"
case "$slot" in
    a) other=b ;;
    b) other=a ;;
    *) log "cannot determine the running slot"; exit 1 ;;
esac

base=/data/.carrel/update
[ -d "$base/payload" ] || exit 0

defs=/run/carrel-update.d
kdefs=/run/carrel-update-kernel.d
mkdir -p "$defs" "$kdefs"
rm -f "$defs"/*.transfer "$kdefs"/*.transfer
# Kernel and initrds first: their version is the kernel version, not the
# release version, so they are a separate sysupdate pass (see
# kernel.transfer).  They must be on the ESP before the new entry can name
# them.  A payload without a kernel archive (up to 0.2.2) makes this a no-op.
cp "/usr/lib/carrel/sysupdate/kernel.transfer" "$kdefs/10-kernel.transfer"
log "installing the update kernel and initrds"
SYSTEMD_LOG_LEVEL=debug /usr/lib/systemd/systemd-sysupdate \
    --definitions="$kdefs" list --json=pretty >>/dev/ttyS0 2>&1 || true
if ! SYSTEMD_LOG_LEVEL=debug /usr/lib/systemd/systemd-sysupdate \
        --definitions="$kdefs" update >>/dev/ttyS0 2>&1; then
    log "kernel update failed; keeping slot $slot"
    exit 1
fi

# Boot entry last: it is the entry point of the update.  Root, verity hashes and the
# signature must be in place before anything can select the new kernel.
cp "/usr/lib/carrel/sysupdate/root.transfer" "$defs/10-root.transfer"
cp "/usr/lib/carrel/sysupdate/verity.transfer" "$defs/20-verity.transfer"
cp "/usr/lib/carrel/sysupdate/sig.transfer" "$defs/30-sig.transfer"
cp "/usr/lib/carrel/sysupdate/entry-$other.transfer" "$defs/40-entry.transfer"

log "applying an update to slot $other from $base"
# The list output is small and makes a rejected/incomplete update set
# diagnosable from the serial console.
SYSTEMD_LOG_LEVEL=debug /usr/lib/systemd/systemd-sysupdate \
    --definitions="$defs" list --json=pretty >>/dev/ttyS0 2>&1 || true
if ! SYSTEMD_LOG_LEVEL=debug /usr/lib/systemd/systemd-sysupdate \
        --definitions="$defs" update >>/dev/ttyS0 2>&1; then
    log "sysupdate failed; keeping slot $slot"
    exit 1
fi

entry="$(ls -1t /boot/loader/entries/carrel-$other-*+*.conf 2>/dev/null | head -1 || true)"
if [ -n "$entry" ]; then
    # systemd-boot displays and matches the entry ID without the boot-count
    # suffix (+3); the file keeps the suffix and is renamed as tries are
    # consumed.  Strip the suffix for loader.conf.
    id="$(basename "$entry")"
    id="${id%%+*}.conf"
    printf 'default %s\ntimeout 2\neditor no\n' "$id" >/boot/loader/loader.conf
    log "default is $id (boot counting)"
fi

# GRUB has no boot counter and no entry files: its kernel command line is generated
# from grubenv.  Read the new root hash from the signed verity signature
# partition, which sysupdate just wrote, and hand it to grub.cfg.
if [ -f /boot/grub/grubenv ]; then
    case "$other" in
        a) sig_uuid=77777777-7777-4777-8777-777777777777 ;;
        b) sig_uuid=88888888-8888-4888-8888-888888888888 ;;
    esac
    sig_dev="$(blkid -t "PARTUUID=$sig_uuid" -o device 2>/dev/null | head -1 || true)"
    if [ -n "$sig_dev" ]; then
        roothash="$(dd if="$sig_dev" bs=4096 count=1 2>/dev/null \
            | tr -d '\000' \
            | sed -n 's/.*"rootHash":"\([0-9a-fA-F]*\)".*/\1/p')"
    fi
    if [ -n "${roothash:-}" ]; then
        grub-editenv /boot/grub/grubenv set \
            "carrel_default=$other" "carrel_tries=3" \
            "carrel_${other}_roothash=$roothash"
        log "grubenv: $(grub-editenv /boot/grub/grubenv list | tr '\n' ' ')"
        log "slot $other roothash is $roothash"
    else
        log "could not read slot $other roothash; keeping the old value"
        grub-editenv /boot/grub/grubenv set \
            "carrel_default=$other" "carrel_tries=3"
        log "grubenv: $(grub-editenv /boot/grub/grubenv list | tr '\n' ' ')"
    fi
fi

# Consume the payload so the new slot does not apply it again (which would
# ping-pong between the two slots).
mv "$base" "$base.applied"
rm -rf "$base.applied"
sync

log "update to slot $other applied; rebooting"
systemctl reboot
