#!/bin/sh
# Apply a staged update with systemd-sysupdate and reboot.
#
# The payload is staged on the data partition (during a sync, or by a service
# technician from a USB stick) as:
#
#   /data/.stylos/update/payload/stylos-root-<slot>-<version>.raw
#   /data/.stylos/update/payload/stylos-verity-<slot>-<version>.raw
#   /data/.stylos/update/payload/stylos-verity-<slot>-sig-<version>.sig
#   /data/.stylos/update/payload/stylos-<slot>-<version>.efi
#
# Only the inactive slot is touched.  The transfer definitions live in
# /usr/lib/stylos/sysupdate and are selected here, so a boot from slot B
# writes slot A and vice versa.
set -eu

log() {
    echo "STYLOS-UPDATE: $*" >&2
    echo "STYLOS-UPDATE: $*" >>/dev/ttyS0 2>/dev/null || true
}

slot="$(sed -n 's/.*stylos\.slot=\([ab]\).*/\1/p' /proc/cmdline)"
case "$slot" in
    a) other=b ;;
    b) other=a ;;
    *) log "cannot determine the running slot"; exit 1 ;;
esac

base=/data/.stylos/update
[ -d "$base/payload" ] || exit 0

defs=/run/stylos-update.d
mkdir -p "$defs"
rm -f "$defs"/*.transfer
# UKI last: it is the entry point of the update.  Root, verity hashes and the
# signature must be in place before anything can select the new kernel.
cp "/usr/lib/stylos/sysupdate/root.transfer" "$defs/10-root.transfer"
cp "/usr/lib/stylos/sysupdate/verity.transfer" "$defs/20-verity.transfer"
cp "/usr/lib/stylos/sysupdate/sig.transfer" "$defs/30-sig.transfer"
cp "/usr/lib/stylos/sysupdate/uki-$other.transfer" "$defs/40-uki.transfer"

log "applying an update to slot $other from $base"
# The list output is small and makes a rejected/incomplete update set
# diagnosable from the serial console.
SYSTEMD_LOG_LEVEL=debug /usr/lib/systemd/systemd-sysupdate \
    --definitions="$defs" list --json=pretty >>/dev/ttyS0 2>&1 || true
if ! SYSTEMD_LOG_LEVEL=debug /usr/lib/systemd/systemd-sysupdate \
        --definitions="$defs" update >>/dev/ttyS0 2>&1; then
    log "sysupdate failed; keeping slot $slot"
    exit 1
fi

uki="$(ls -1t /boot/EFI/Linux/stylos-$other-*+*.efi 2>/dev/null | head -1 || true)"
if [ -n "$uki" ]; then
    # systemd-boot displays and matches the entry ID without the boot-count
    # suffix (+3); the file keeps the suffix and is renamed as tries are
    # consumed.  Strip the suffix for loader.conf.
    id="$(basename "$uki")"
    id="${id%%+*}.efi"
    printf 'default %s\ntimeout 2\n' "$id" >/boot/loader/loader.conf
    log "default is $id (boot counting)"
fi

# GRUB has no boot counter and no UKI: its kernel command line is generated
# from grubenv.  Read the new root hash from the signed verity signature
# partition, which sysupdate just wrote, and hand it to grub.cfg.
if [ -f /boot/grub/grubenv ]; then
    case "$other" in
        a) sig_uuid=77777777-7777-4777-8777-777777777777 ;;
        b) sig_uuid=88888888-8888-4888-8888-888888888888 ;;
    esac
    sig_dev="$(blkid -t "PARTUUID=$sig_uuid" -o device 2>/dev/null | head -1 || true)"
    if [ -n "$sig_dev" ]; then
        roothash="$(dd if="$sig_dev" bs=4096 count=1 2>/dev/null \
            | tr -d '\000' \
            | sed -n 's/.*"rootHash":"\([0-9a-fA-F]*\)".*/\1/p')"
    fi
    if [ -n "${roothash:-}" ]; then
        grub-editenv /boot/grub/grubenv set \
            "stylos_default=$other" "stylos_tries=3" \
            "stylos_${other}_roothash=$roothash"
        log "grubenv: $(grub-editenv /boot/grub/grubenv list | tr '\n' ' ')"
        log "slot $other roothash is $roothash"
    else
        log "could not read slot $other roothash; keeping the old value"
        grub-editenv /boot/grub/grubenv set \
            "stylos_default=$other" "stylos_tries=3"
        log "grubenv: $(grub-editenv /boot/grub/grubenv list | tr '\n' ' ')"
    fi
fi

# Consume the payload so the new slot does not apply it again (which would
# ping-pong between the two slots).
mv "$base" "$base.applied"
rm -rf "$base.applied"
sync

log "update to slot $other applied; rebooting"
systemctl reboot
