# Root filesystem.  Both slots are labelled stylos-root-<version>; the version
# is what systemd-sysupdate compares, and it always writes the older (inactive)
# one.  The partition UUIDs never change, so the UKI/GRUB command line can keep
# naming the same verity devices.
[Transfer]

[Source]
Type=regular-file
Path=/data/.stylos/update/payload
MatchPattern=stylos-root-@v.raw

[Target]
Type=partition
Path=auto
MatchPartitionType=root-x86-64
MatchPattern=stylos-root-@v
