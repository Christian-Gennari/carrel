# dm-verity hash tree for the root filesystem.  It must be installed with the
# root it belongs to; the UKI/GRUB roothash is what authenticates the pair.
[Transfer]

[Source]
Type=regular-file
Path=/data/.stylos/update/payload
MatchPattern=stylos-verity-@v.raw

[Target]
Type=partition
Path=auto
MatchPartitionType=root-x86-64-verity
MatchPattern=stylos-verity-@v
