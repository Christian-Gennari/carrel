#!/bin/bash
# Stylos installer.
#
# Runs only when the running root is on a USB disk (removable or TRAN=usb).
# Offers "Try Stylos" or "Install to this computer".  Installing copies the
# running USB image to the internal disk with dd, grows the data partition to
# fill the disk, makes Stylos the first UEFI boot entry (when the computer
# booted in UEFI mode) and reboots.  The writer must type ERASE; there is no
# other confirmation path.
set -u

export TERM=linux
export NCURSES_NO_UTF8_ACS=1

TTY=/dev/tty1
log() {
    echo "STYLOS-INSTALLER: $*" >>/dev/ttyS0 2>/dev/null || true
}

# The installer is only for USB boots.  Booting the installed disk skips it.
root_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
# With dm-verity the root is /dev/mapper/root; follow the dependency chain
# backwards to the physical disk (lsblk -s) instead of only looking at the
# immediate parent.
src_disk="$(lsblk -srno NAME "$root_src" 2>/dev/null | tail -1 | tr -d ' ' || true)"
[ -n "$src_disk" ] || exit 0
removable="$(cat "/sys/block/$src_disk/removable" 2>/dev/null || echo 0)"
transport="$(lsblk -dno TRAN "/dev/$src_disk" 2>/dev/null | tr -d ' ' || true)"
if [ "$removable" != "1" ] && [ "$transport" != "usb" ]; then
    log "internal boot on /dev/$src_disk; not the installer"
    exit 0
fi

log "USB boot on /dev/$src_disk"

# Make Stylos the default UEFI boot entry.  The entry points at Microsoft-
# signed shim on the new ESP, so Secure Boot stays on and the writer never opens
# the firmware settings.  Best effort: a firmware that refuses the entry still
# boots the disk through the removable-media path (EFI/BOOT/BOOTX64.EFI).
# Numbers of the firmware boot entries labelled "Stylos".
stylos_entries() {
    efibootmgr 2>/dev/null \
        | awk '$1 ~ /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]\*?$/ && $2 == "Stylos" {print substr($1, 5, 4)}'
}

register_boot_entry() {
    local disk="/dev/$1" esp number new order rest
    [ -d /sys/firmware/efi ] || { log "BIOS boot; no UEFI boot entry"; return 0; }
    if ! mountpoint -q /sys/firmware/efi/efivars; then
        mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
    fi
    command -v efibootmgr >/dev/null 2>&1 || { log "efibootmgr is missing"; return 0; }
    udevadm settle >/dev/null 2>&1 || true
    blockdev --rereadpt "$disk" >/dev/null 2>&1 || true
    udevadm settle >/dev/null 2>&1 || true
    esp="$(lsblk -nlo PATH,PARTUUID "$disk" 2>/dev/null \
        | awk 'tolower($2)=="44444444-4444-4444-8444-444444444444"{print $1; exit}')"
    if [ -z "$esp" ]; then
        log "no ESP found on $disk; no UEFI boot entry"
        return 0
    fi
    number="$(cat "/sys/class/block/${esp##*/}/partition" 2>/dev/null || true)"
    [ -n "$number" ] || { log "no partition number for $esp"; return 0; }

    # Remove entries from an earlier install, then create ours.
    for old in $(stylos_entries); do
        efibootmgr -q -b "$old" -B >/dev/null 2>&1 || true
    done
    if ! efibootmgr -q -c -d "$disk" -p "$number" -L Stylos \
            -l '\EFI\stylos\shimx64.efi' >/dev/null 2>&1; then
        log "efibootmgr could not create the Stylos entry"
        return 0
    fi
    new="$(stylos_entries | head -1)"
    # efibootmgr -c already puts the new entry first; make it explicit so a
    # firmware that appends does not leave another system in front.
    if [ -n "$new" ]; then
        order="$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: *//p')"
        rest="$(printf '%s' "$order" | tr ',' '\n' | grep -v -i "^$new\$" | paste -sd, -)"
        if [ -n "$rest" ]; then
            efibootmgr -q -o "$new,$rest" >/dev/null 2>&1 || true
        else
            efibootmgr -q -o "$new" >/dev/null 2>&1 || true
        fi
    fi
    efibootmgr -v 2>&1 | while read -r line; do log "efibootmgr: $line"; done
    log "UEFI boot entry Stylos is first (Boot${new:-????})"
}

menu() {
    log "main menu"
    whiptail --title "Stylos" --menu \
        "This USB stick runs Stylos. You can try it, or install it on this computer." \
        15 70 2 \
        "try" "Try Stylos (nothing is changed)" \
        "install" "Install to this computer" \
        3>&1 1>&2 2>&3
}

choose_disk() {
    local args=() name size model
    while read -r line; do
        eval "$line"
        [ "$TYPE" = "disk" ] || continue
        [ "$NAME" = "$src_disk" ] && continue
        case "$NAME" in loop*|sr*|zram*|ram*) continue ;; esac
        # Only internal disks: no removable media and no USB transport.
        local rm tran
        rm="$(cat "/sys/block/$NAME/removable" 2>/dev/null || echo 0)"
        tran="$(lsblk -dno TRAN "/dev/$NAME" 2>/dev/null | tr -d ' ' || true)"
        [ "$rm" = "1" ] && continue
        [ "$tran" = "usb" ] && continue
        args+=("$NAME" "$SIZE $MODEL")
    done < <(lsblk -b -d -n -P -o NAME,TYPE,SIZE,MODEL)

    [ "${#args[@]}" -gt 0 ] || return 1
    log "disk menu"
    whiptail --title "Install Stylos" --menu \
        "Choose the internal disk to erase and install Stylos on." \
        20 70 10 "${args[@]}" 3>&1 1>&2 2>&3
}

while true; do
    choice="$(menu)" || { log "cancelled; powering off"; systemctl poweroff; exit 0; }
    if [ "$choice" = "try" ]; then
        log "try selected"
        exit 0
    fi

    target="$(choose_disk)" || {
        whiptail --title "Install Stylos" --msgbox \
            "No internal disk was found. Stylos can only be installed on an internal disk." \
            10 70
        continue
    }

    size_bytes="$(lsblk -b -dno SIZE "/dev/$target" 2>/dev/null || echo 0)"
    if [ "$size_bytes" -lt $((8 * 1024 * 1024 * 1024)) ]; then
        whiptail --title "Install Stylos" --msgbox \
            "/dev/$target is smaller than 8 GB. Stylos needs at least 8 GB." 10 70
        continue
    fi

    log "erase prompt"
    answer="$(whiptail --title "Install Stylos" --inputbox \
        "This erases everything on /dev/$target, including other operating systems and files.

Type ERASE (in capitals) to continue." \
        12 70 3>&1 1>&2 2>&3)" || continue
    log "erase prompt answered"
    if [ "$answer" != "ERASE" ]; then
        whiptail --title "Install Stylos" --msgbox \
            "The word ERASE was not typed. Nothing was changed." 9 60
        continue
    fi

    log "installing /dev/$src_disk -> /dev/$target"
    whiptail --title "Installing Stylos" --infobox \
        "Writing Stylos to /dev/$target. Do not unplug the computer." 8 70
    if ! dd if="/dev/$src_disk" of="/dev/$target" bs=4M conv=fsync status=none; then
        whiptail --title "Install Stylos" --msgbox \
            "Writing to /dev/$target failed. Nothing was changed." 9 70
        log "dd failed"
        continue
    fi
    sync
    log "image written; growing the data partition"
    /usr/lib/stylos/grow-data "/dev/$target" >>/dev/ttyS0 2>&1 || true
    sync
    register_boot_entry "$target"
    log "complete on /dev/$target"
    whiptail --title "Stylos installed" --msgbox \
        "Stylos is installed on /dev/$target.

Remove the USB stick, then press Enter to reboot." 10 70
    log "rebooting"
    systemctl reboot
    exit 0
done
