#!/bin/sh
# Download the pinned Typst release and install it into the image.
#
# Debian trixie has no typst CLI package, but spec/01-architecture.md requires
# typst for PDF export (pandoc + typst, no LaTeX).  The upstream musl binary is
# static, so this adds no runtime dependencies.  The version and checksum are
# pinned; update both together.
set -eu

[ "${1:-}" = "final" ] || exit 0

version=0.15.1
sha256=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c
url="https://github.com/typst/typst/releases/download/v${version}/typst-x86_64-unknown-linux-musl.tar.xz"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The kernel is pinned to 6.12.116+deb13-amd64, the kernel that 0.1.0 and
# 0.2.0 devices carry on their ESP.  Their update code installs only the
# root, verity hash, signature and boot entry, so a 0.2.2 payload whose entry
# names a different kernel would never appear in systemd-boot on those
# devices.  Debian's mirror only keeps the newest 6.12.x, so fetch the signed
# package from snapshot.debian.org; version and checksum are pinned here.
kernel_version=6.12.116+deb13-amd64
kernel_deb_version=6.12.116-1
kernel_sha256=0cee1131391727e0974245f197cfb22f3d8715ac2428574b290aaf16ff6eda1c
kernel_url="https://snapshot.debian.org/archive/debian-security/20261108T202647Z/pool/updates/main/l/linux-signed-amd64/linux-image-${kernel_version}_${kernel_deb_version}_amd64.deb"

curl -fsSL "$kernel_url" -o "$tmp/linux-image.deb"
echo "$kernel_sha256  $tmp/linux-image.deb" | sha256sum -c -
# mkosi-chroot mounts a private /tmp, so put the package in the image's /root
# (not a mount) where dpkg can see it.
install -m 0644 "$tmp/linux-image.deb" "$BUILDROOT/root/linux-image.deb"
mkosi-chroot dpkg -i /root/linux-image.deb
rm -f "$BUILDROOT/root/linux-image.deb"
if [ ! -f "$BUILDROOT/boot/vmlinuz-$kernel_version" ] || \
   [ ! -d "$BUILDROOT/usr/lib/modules/$kernel_version" ]; then
    echo "mkosi.prepare: the pinned $kernel_version kernel was not installed" >&2
    exit 1
fi

curl -fsSL "$url" -o "$tmp/typst.tar.xz"
echo "$sha256  $tmp/typst.tar.xz" | sha256sum -c -
tar -xJf "$tmp/typst.tar.xz" -C "$tmp"

install -D -m 0755 "$tmp/typst-x86_64-unknown-linux-musl/typst" \
    "$BUILDROOT/usr/bin/typst"
install -D -m 0644 "$tmp/typst-x86_64-unknown-linux-musl/LICENSE" \
    "$BUILDROOT/usr/share/doc/typst/LICENSE"
install -D -m 0644 "$tmp/typst-x86_64-unknown-linux-musl/NOTICE" \
    "$BUILDROOT/usr/share/doc/typst/NOTICE"

# Source Serif 4 is not packaged in Debian trixie.  Fetch the pinned upstream
# desktop release (OFL-1.1) and install the TTF family; version and checksum
# are pinned like typst above.
serif_version=4.005
serif_sha256=549fdb8f9a682bd06944298621404969f6de77c2e422ff3b8244a1dcd6a0c425
serif_url="https://github.com/adobe-fonts/source-serif/releases/download/4.005R/source-serif-${serif_version}_Desktop.zip"

curl -fsSL "$serif_url" -o "$tmp/source-serif.zip"
echo "$serif_sha256  $tmp/source-serif.zip" | sha256sum -c -

SERIF_ZIP="$tmp/source-serif.zip" \
SERIF_DEST="$BUILDROOT/usr/share/fonts/truetype/source-serif-4" \
SERIF_DOC="$BUILDROOT/usr/share/doc/fonts-source-serif-4" \
python3 - <<'PY'
import os
import zipfile

archive = zipfile.ZipFile(os.environ["SERIF_ZIP"])
dest = os.environ["SERIF_DEST"]
os.makedirs(dest, exist_ok=True)
prefix = "source-serif-4.005_Desktop/TTF/"
count = 0
for name in archive.namelist():
    if not name.startswith(prefix) or not name.lower().endswith(".ttf"):
        continue
    with archive.open(name) as source, open(
        os.path.join(dest, os.path.basename(name)), "wb"
    ) as target:
        target.write(source.read())
    count += 1
if count == 0:
    raise SystemExit("source-serif archive contains no TTF files")
with archive.open("source-serif-4.005_Desktop/LICENSE.md") as source:
    licence = source.read()
os.makedirs(os.environ["SERIF_DOC"], exist_ok=True)
with open(os.path.join(os.environ["SERIF_DOC"], "LICENSE"), "wb") as target:
    target.write(licence)
PY
